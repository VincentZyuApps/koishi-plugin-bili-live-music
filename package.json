{
  "name": "koishi-plugin-bili-live-music",
  "description": "🎵 B站直播间点歌，支持弹幕、Bot与WebUI队列管理 🎛️，可使用OBS浏览器或VLC播放音频 ✨",
  "version": "0.4.1-alpha.3+20260813",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "assets"
  ],
  "license": "MIT",
  "homepage": "https://github.com/VincentZyuApps/koishi-plugin-bili-live-music",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VincentZyuApps/koishi-plugin-bili-live-music.git"
  },
  "bugs": {
    "url": "https://github.com/VincentZyuApps/koishi-plugin-bili-live-music/issues"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node -e \"const fs = require('node:fs'); if (!fs.existsSync('lib/index.js')) { console.error('Missing lib/index.js. Run yarn build bili-live-music before packing or publishing.'); process.exit(1) }\""
  },
  "koishi": {
    "browser": true,
    "service": {
      "required": [
        "node"
      ],
      "optional": [
        "console"
      ]
    }
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "axios": "^1.18.1",
    "fastify": "^5.5.0"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.0",
    "koishi": "^4.18.7",
    "koishi-plugin-w-node": "^2.0.0"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.0"
  }
}
